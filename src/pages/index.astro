---
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuItemCard from '../components/MenuItemCard.astro';
import SuasanaGrid from '../components/SuasanaGrid.astro';
import { menuItems } from '../data/menu';

// 6 Menu Terbaik: 2 Minuman, 2 Makanan, 2 Snack
const bestDrinkIds = ['kopi-ndalem', 'wedang-rempah'];
const bestFoodIds = ['sego-blendi', 'bakmi-jowo'];
const bestSnackIds = ['pisang-goreng', 'tempe-mendoan'];

const bestDrinks = menuItems.filter((i) => bestDrinkIds.includes(i.id));
const bestFoods = menuItems.filter((i) => bestFoodIds.includes(i.id));
const bestSnacks = menuItems.filter((i) => bestSnackIds.includes(i.id));

// Susun teratur: 1 Baris 3 Card (2 baris x 3 kolom = 6 kartu)
const curatedBest6 = [
  bestDrinks.find((i) => i.id === 'kopi-ndalem') || bestDrinks[0],
  bestFoods.find((i) => i.id === 'sego-blendi') || bestFoods[0],
  bestSnacks.find((i) => i.id === 'pisang-goreng') || bestSnacks[0],
  bestDrinks.find((i) => i.id === 'wedang-rempah') || bestDrinks[1],
  bestFoods.find((i) => i.id === 'bakmi-jowo') || bestFoods[1],
  bestSnacks.find((i) => i.id === 'tempe-mendoan') || bestSnacks[1],
].filter(Boolean);

const RESERVATION_WA_URL = "https://wa.me/6281234567890?text=Halo%20Ndalem%20Kopi,%20saya%20mau%20reservasi%20meja%20untuk%20ngopi%20lan%20mangan.";
---

<BaseLayout
  title="Ndalem Kopi — Ngopi, Mangan, lan Crita"
  description="Sugeng rawuh ing Ndalem Kopi. Ruang santai bernuansa Jawa kontemporer kanggo ngopi, mangan, lan crita tanpa perlu kesusu."
>
  <!-- ===================================================================
       HERO SECTION: CENTERED EDITORIAL (Reference: najibbahrudin.com)
       Minimal text, balanced typography, background photo with low opacity
       =================================================================== -->
  <section class="hero-section" aria-label="Hero Ndalem Kopi">
    <div class="container hero-container">
      <div class="hero-content">
        <!-- Small Category Pill -->
        <div class="hero-chip">
          <span class="chip-dot"></span>
          <span>Ruang Santai & Pawon Tradisi</span>
        </div>

        <!-- Say Hello / Greeting -->
        <p class="hero-greeting italic-jawa font-serif">Selamat datang ! ing</p>

        <!-- Balanced Brand Title -->
        <h1 class="hero-title font-serif">Ndalem Kopi</h1>

        <!-- Tagline directly under Title -->
        <p class="hero-tagline italic-jawa font-serif">“Ngopi, mangan, lan crita”</p>

        <!-- Concise Balanced Description (Not too long) -->
        <p class="hero-desc">
          Papan kanggo mulih lan ngaso. Nikmati seduhan kopi tubruk racikan mantap, angeting wedang rempah alami, lan lawuh pawon tradisi ing swasana pendopo Jawa sing asri.
        </p>

        <!-- 2 Side-by-Side Action Buttons -->
        <div class="hero-actions">
          <a href="/menu" class="btn btn-primary btn-hero" id="hero-menu-cta">
            <span>Delok Menu</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>

          <a
            href={RESERVATION_WA_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary btn-hero btn-wa"
            id="hero-reservasi-cta"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>Reservasi Meja (WA)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================
       6 MENU KLANGENAN TERBAIK (Reference: galektech.vercel.app/project)
       1 Baris 3 Card, compact footprint, total 6 cards
       =================================================================== -->
  <section class="section section-surface" id="menu-unggulan" aria-label="Menu Pilihan">
    <div class="container">
      <div class="section-title-wrap text-center">
        <span class="eyebrow">SUGUHAN KLANGENAN</span>
        <h2 class="section-heading-title font-serif">6 Suguhan Paling Favorit</h2>
        <p class="section-heading-sub">
          Pilihan paling pas kanggo ngancani critamu: 2 ombenan khas, 2 panganan wareg, lan 2 kudapan renyah.
        </p>
      </div>

      <!-- Grid 1 Row 3 Cards (Total 6 cards, compact footprint) -->
      <div class="best-six-grid">
        {curatedBest6.map((item) => (
          <MenuItemCard item={item} variant="compact" />
        ))}
      </div>

      <!-- Show More CTA Button (Direct ke /menu) -->
      <div class="menu-cta-wrap text-center">
        <a href="/menu" class="btn btn-primary btn-show-more" id="btn-show-more-menu">
          <span>Delok Sak Kabehe Menu</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <p class="menu-cta-caption">
          Tersedia puluhan racikan kopi tubruk, wedangan rempah, es seger, sego serba 10K, lan gorengan.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================================================================
       TENTANG SINGKAT (CERITA NDALEM)
       =================================================================== -->
  <section class="section" id="critane-ndalem" aria-label="Tentang Ndalem Kopi">
    <div class="container-narrow text-center">
      <div class="critane-content">
        <span class="eyebrow"><span class="italic-jawa">Cerita Ndalem</span></span>
        <h2 class="critane-quote font-serif">
          “Ndalem iku papan kanggo mulih.”
        </h2>
        <p class="critane-sub">
          Papan sing nampa sapa wae kanthi ati tulus, hawane adhem, lan suguhane ngelingake rasa omah.
        </p>
        
        <div class="critane-divider">
          <span class="divider-line"></span>
          <span class="divider-dot">✦</span>
          <span class="divider-line"></span>
        </div>

        <p class="critane-desc">
          Kami ingin membuat ruang sederhana untuk <span class="italic-jawa">ngopi, mangan, lan crita</span>, berhenti sejenak dari ramainya hari. Kaya dene mulih nang omah simbah, kabeh diracik kanthi rasa paseduluran sing tulus.
        </p>

        <div class="critane-action">
          <a href="/tentang" class="link-arrow">
            <span>Waca <span class="italic-jawa">Cerita Ndalem</span> selengkapnya</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================
       SUASANA NDALEM (FOTO GRID PENDOPO)
       =================================================================== -->
  <section class="section section-surface" id="suasana-ndalem" aria-label="Suasana Ndalem Kopi">
    <div class="container">
      <SuasanaGrid showTitle={true} />
    </div>
  </section>

  <!-- ===================================================================
       FINAL RESERVASI CTA
       =================================================================== -->
  <section class="section section-dark text-center" aria-label="Ayo Mampir">
    <div class="container-narrow">
      <span class="eyebrow" style="color:var(--color-amber);">MAMPIR NANG NDALEM</span>
      <h2 class="final-cta-title font-serif">Wis siap <span class="italic-jawa">ngopi, mangan, lan crita</span>?</h2>
      <p class="final-cta-desc">
        Hubungi kasir pawon kami langsung via WhatsApp untuk reservasi meja rombongan utawa pesen suguhan sadurunge teka.
      </p>
      <div class="final-cta-action" style="display:flex; justify-content:center; gap:1rem; flex-wrap:wrap;">
        <a href={RESERVATION_WA_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="background-color:var(--color-terracotta); border-color:var(--color-terracotta);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Reservasi Meja (WhatsApp)</span>
        </a>
        <a href="/menu" class="btn btn-outline-light">
          <span>Delok Menu Lengkap</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==========================================================================
     HERO SECTION: CENTERED EDITORIAL (Reference: najibbahrudin.com)
     ========================================================================== */
  .hero-section {
    position: relative;
    min-height: 82vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-20);
    background-color: #17110C;
    background-image: 
      radial-gradient(circle at center, rgba(23, 17, 12, 0.65) 0%, rgba(15, 10, 7, 0.94) 100%),
      url('/images/hero/hero-ndalem.webp');
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    color: #FAF7F2;
    overflow: hidden;
    text-align: center;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 860px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Pill chip */
  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #E6D2BC;
    background-color: rgba(43, 31, 23, 0.85);
    border: 1px solid rgba(184, 93, 25, 0.4);
    padding: 0.35rem 0.95rem;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-3);
    backdrop-filter: blur(6px);
  }

  .chip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-amber);
    box-shadow: 0 0 8px rgba(224, 122, 38, 0.6);
  }

  /* Say Hello / Greeting text */
  .hero-greeting {
    font-size: 1.15rem;
    color: #D4BAA0;
    margin: 0 0 0.35rem 0;
    font-style: italic;
    letter-spacing: 0.02em;
  }

  /* Brand Title: Balanced, not oversized */
  .hero-title {
    font-size: 2.75rem;
    font-weight: 700;
    color: #FAF7F2;
    line-height: 1.15;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.015em;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 3.5rem;
    }
  }

  /* Tagline directly under title */
  .hero-tagline {
    font-size: 1.25rem;
    color: var(--color-terracotta);
    font-style: italic;
    margin: 0 0 1.25rem 0;
    line-height: 1.35;
  }

  @media (min-width: 640px) {
    .hero-tagline {
      font-size: 1.45rem;
    }
  }

  /* Balanced concise description */
  .hero-desc {
    font-size: 1rem;
    color: #C8B9A8;
    line-height: 1.7;
    margin: 0 auto var(--space-8) auto;
    max-width: 580px;
  }

  @media (min-width: 640px) {
    .hero-desc {
      font-size: 1.0625rem;
    }
  }

  /* 2 Buttons side-by-side */
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .btn-hero {
    padding: 0.85rem 1.85rem;
    font-size: 0.9375rem;
    border-radius: var(--radius-md);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .hero-actions .btn-primary {
    background-color: var(--color-terracotta);
    border-color: var(--color-terracotta);
    color: #FAF7F2;
    box-shadow: 0 4px 14px rgba(184, 93, 25, 0.35);
  }

  .hero-actions .btn-primary:hover {
    background-color: #C9671C;
    border-color: #C9671C;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(184, 93, 25, 0.45);
  }

  .hero-actions .btn-wa {
    background-color: rgba(255, 255, 255, 0.08);
    color: #FAF7F2;
    border: 1px solid rgba(250, 247, 242, 0.25);
    backdrop-filter: blur(4px);
  }

  .hero-actions .btn-wa:hover {
    border-color: #22C55E;
    color: #22C55E;
    background-color: rgba(34, 197, 94, 0.12);
    transform: translateY(-2px);
  }

  /* ==========================================================================
     BEST 6 MENU GRID (1 Row 3 Cards, compact footprint)
     ========================================================================== */
  .section-title-wrap {
    margin-bottom: var(--space-8);
  }

  .section-heading-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-wood);
    margin-bottom: var(--space-2);
  }

  .section-heading-sub {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* 3 Cards per row (desktop), compact grid */
  .best-six-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 640px) {
    .best-six-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
  }

  @media (min-width: 960px) {
    .best-six-grid {
      grid-template-columns: repeat(3, 1fr); /* 1 Row 3 Cards */
      gap: var(--space-5);
    }
  }

  .btn-show-more {
    padding: 0.85rem 2.25rem;
    font-size: 1rem;
    border-radius: var(--radius-md);
  }

  .menu-cta-caption {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-3);
  }

  /* ==========================================================================
     CERITA NDALEM
     ========================================================================== */
  .critane-quote {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-wood);
    margin: var(--space-3) 0 var(--space-2);
  }

  .critane-sub {
    font-size: 1.125rem;
    color: var(--color-terracotta);
    font-family: var(--font-serif);
    margin-bottom: var(--space-4);
  }

  .critane-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin: var(--space-6) 0;
  }

  .divider-line {
    width: 60px;
    height: 1px;
    background-color: var(--color-border);
  }

  .divider-dot {
    color: var(--color-amber);
    font-size: 0.75rem;
  }

  .critane-desc {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: var(--space-8);
  }

  /* Final CTA */
  .section-dark {
    background-color: var(--color-wood);
    color: #FAF7F2;
  }

  .final-cta-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: #FAF7F2;
    margin-bottom: var(--space-3);
  }

  .final-cta-desc {
    font-size: var(--text-base);
    color: var(--color-text-light-muted);
    max-width: 580px;
    margin: 0 auto var(--space-8);
    line-height: 1.7;
  }
</style>
