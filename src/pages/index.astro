---
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuItemCard from '../components/MenuItemCard.astro';
import SuasanaGrid from '../components/SuasanaGrid.astro';
import { menuItems } from '../data/menu';

// 6 Menu Terbaik: 2 Minuman, 2 Makanan, 2 Snack
const bestDrinkIds = ['kopi-ndalem', 'wedang-rempah'];
const bestFoodIds = ['sego-blendi', 'bakmi-jowo'];
const bestSnackIds = ['pisang-goreng-wijen', 'tempe-mendoan'];

const bestDrinks = menuItems.filter((i) => bestDrinkIds.includes(i.id));
const bestFoods = menuItems.filter((i) => bestFoodIds.includes(i.id));
const bestSnacks = menuItems.filter((i) => bestSnackIds.includes(i.id));

// Susun teratur: 3 kartu per row (2 baris x 3 kolom = 6 kartu)
const curatedBest6 = [
  bestDrinks[0], // Kopi Ndalem
  bestFoods[0],  // Sego Blendi
  bestSnacks[0], // Pisang Goreng Wijen
  bestDrinks[1], // Wedang Rempah
  bestFoods[1],  // Bakmi Jowo
  bestSnacks[1]  // Tempe Mendoan
].filter(Boolean);

const RESERVATION_WA_URL = "https://wa.me/6281234567890?text=Halo%20Ndalem%20Kopi,%20saya%20mau%20reservasi%20meja%20untuk%20ngopi%20lan%20mangan.";
---

<BaseLayout
  title="Ndalem Kopi — Ngopi, Mangan, lan Crita"
  description="Sugeng rawuh ing Ndalem Kopi. Ruang santai bernuansa Jawa kontemporer kanggo ngopi, mangan, lan crita tanpa perlu kesusu."
>
  <!-- ===================================================================
       HERO SECTION: BUAGIS POL (Atmospheric Contemporary Javanese Editorial)
       =================================================================== -->
  <section class="hero-section" aria-label="Hero Ndalem Kopi">
    <div class="hero-bg-accent" aria-hidden="true"></div>
    <div class="container hero-container">
      <div class="hero-grid">
        <!-- Kolom Teks Hero -->
        <div class="hero-content">
          <div class="hero-eyebrow-chip">
            <span class="chip-dot">✦</span>
            <span>WARISAN RASA & SWASANA JAWA</span>
            <span class="chip-dot">✦</span>
          </div>

          <h1 class="hero-title font-serif">Ndalem Kopi</h1>

          <p class="hero-tagline">
            “<span class="italic-jawa">Ngopi, mangan, lan crita</span> tanpa perlu kesusu.”
          </p>

          <p class="hero-desc">
            Papan kanggo mulih lan ngaso. Nikmati seduhan kopi tubruk racikan mantap, angeting wedangan rempah komplit alami, lan lawuh sego blendi ing swasana pendopo joglo Jawa sing asri kanthi rasa paseduluran sing tulus.
          </p>

          <div class="hero-actions">
            <a href="/menu" class="btn btn-primary btn-hero" id="hero-menu-cta">
              <span>Delok Sak Kabehe Menu</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </a>

            <a
              href={RESERVATION_WA_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary btn-hero btn-wa"
              id="hero-reservasi-cta"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Reservasi Meja (WA)</span>
            </a>
          </div>

          <!-- Feature Highlights -->
          <div class="hero-features">
            <div class="hero-feature-item">
              <span class="feature-icon">☕</span>
              <div>
                <strong>Kopi & Wedang</strong>
                <span>Racikan murni alami</span>
              </div>
            </div>
            <div class="hero-feature-item">
              <span class="feature-icon">🍲</span>
              <div>
                <strong>Pawon Tradisi</strong>
                <span>Sego blendi & bakmi</span>
              </div>
            </div>
            <div class="hero-feature-item">
              <span class="feature-icon">🌿</span>
              <div>
                <strong>Swasana Asri</strong>
                <span>Pendopo adhem ayem</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Kolom Visual Hero -->
        <div class="hero-visual">
          <div class="hero-image-card">
            <div class="picture-frame hero-image-frame">
              <img
                src="/images/hero/hero-ndalem.webp"
                alt="Suasana pendopo asri Ndalem Kopi"
                width="1200"
                height="900"
                loading="eager"
              />
              <div class="hero-stamp font-serif">
                <span>EST. JAWA TENGAH</span>
              </div>
              <div class="hero-image-badge">
                <span class="badge-dot-live"></span>
                <span>Buka Saben Dina · 08.00 - 23.00 WIB</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================
       6 MENU KLANGENAN TERBAIK (2 Minuman, 2 Makanan, 2 Snack — 1 Row 3 Cards)
       =================================================================== -->
  <section class="section section-surface" id="menu-unggulan" aria-label="Menu Pilihan">
    <div class="container">
      <div class="section-title-wrap text-center">
        <span class="eyebrow">SUGUHAN KLANGENAN</span>
        <h2 class="section-heading-title font-serif">6 Suguhan Paling Favorit</h2>
        <p class="section-heading-sub">
          Pilihan paling pas kanggo ngancani critamu ing pendopo: 2 ombenan khas, 2 panganan wareg, lan 2 kudapan renyah.
        </p>
      </div>

      <!-- Grid 1 Row 3 Cards (Total 6 cards dalam 2 baris) -->
      <div class="best-six-grid">
        {curatedBest6.map((item) => (
          <MenuItemCard item={item} variant="card" />
        ))}
      </div>

      <!-- Show More CTA Button (Direct ke /menu) -->
      <div class="menu-cta-wrap text-center">
        <a href="/menu" class="btn btn-primary btn-show-more" id="btn-show-more-menu">
          <span>Delok Sak Kabehe Menu (Lihat Semua Menu)</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <p class="menu-cta-caption">
          Tersedia puluhan racikan kopi panas, wedang rempah, es seger, sego serba 10K, lan gorengan.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================================================================
       TENTANG SINGKAT (CERITA NDALEM)
       =================================================================== -->
  <section class="section" id="critane-ndalem" aria-label="Tentang Ndalem Kopi">
    <div class="container-narrow text-center">
      <div class="critane-content">
        <span class="eyebrow"><span class="italic-jawa">Cerita Ndalem</span></span>
        <h2 class="critane-quote font-serif">
          “Ndalem iku papan kanggo mulih.”
        </h2>
        <p class="critane-sub">
          Papan sing nampa sapa wae kanthi ati tulus, hawane adhem, lan suguhane ngelingake rasa omah.
        </p>
        
        <div class="critane-divider">
          <span class="divider-line"></span>
          <span class="divider-dot">✦</span>
          <span class="divider-line"></span>
        </div>

        <p class="critane-desc">
          Kami ingin membuat ruang sederhana untuk <span class="italic-jawa">ngopi, mangan, lan crita</span>, berhenti sejenak dari ramainya hari. Kaya dene mulih nang omah simbah, kabeh diracik kanthi rasa paseduluran sing tulus.
        </p>

        <div class="critane-action">
          <a href="/tentang" class="link-arrow">
            <span>Waca <span class="italic-jawa">Cerita Ndalem</span> selengkapnya</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================
       SUASANA NDALEM (FOTO GRID PENDOPO)
       =================================================================== -->
  <section class="section section-surface" id="suasana-ndalem" aria-label="Suasana Ndalem Kopi">
    <div class="container">
      <SuasanaGrid showTitle={true} />
    </div>
  </section>

  <!-- ===================================================================
       FINAL RESERVASI CTA
       =================================================================== -->
  <section class="section section-dark text-center" aria-label="Ayo Mampir">
    <div class="container-narrow">
      <span class="eyebrow" style="color:var(--color-amber);">MAMPIR NANG NDALEM</span>
      <h2 class="final-cta-title font-serif">Wis siap <span class="italic-jawa">ngopi, mangan, lan crita</span>?</h2>
      <p class="final-cta-desc">
        Hubungi kasir pawon kami langsung via WhatsApp untuk reservasi meja rombongan utawa pesen suguhan sadurunge teka.
      </p>
      <div class="final-cta-action" style="display:flex; justify-content:center; gap:1rem; flex-wrap:wrap;">
        <a href={RESERVATION_WA_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="background-color:var(--color-terracotta); border-color:var(--color-terracotta);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Reservasi Meja (WhatsApp)</span>
        </a>
        <a href="/menu" class="btn btn-outline-light">
          <span>Delok Menu Lengkap</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==========================================================================
     HERO SECTION ENHANCEMENT (Buagis Pol)
     ========================================================================== */
  .hero-section {
    position: relative;
    min-height: calc(100vh - 4.5rem);
    display: flex;
    align-items: center;
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    background: radial-gradient(circle at 80% 25%, #FFFFFF 0%, var(--color-bg-base) 70%);
    overflow: hidden;
  }

  .hero-bg-accent {
    position: absolute;
    top: -150px;
    right: -150px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(184, 93, 25, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-12);
    }
  }

  .hero-eyebrow-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-terracotta);
    background-color: #F8EDE0;
    border: 1px solid rgba(184, 93, 25, 0.25);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-4);
  }

  .chip-dot {
    font-size: 0.625rem;
    color: var(--color-amber);
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 700;
    color: var(--color-wood);
    line-height: 1.1;
    margin-bottom: var(--space-3);
    letter-spacing: -0.02em;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-title {
      font-size: 4rem;
    }
  }

  .hero-tagline {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--color-terracotta);
    margin-bottom: var(--space-4);
    line-height: 1.4;
  }

  @media (min-width: 640px) {
    .hero-tagline {
      font-size: 1.35rem;
    }
  }

  .hero-desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-8);
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .btn-hero {
    padding: 0.85rem 1.75rem;
    font-size: var(--text-base);
    border-radius: var(--radius-md);
  }

  .btn-wa {
    background-color: #FFFFFF;
    color: var(--color-wood);
    border: 1px solid var(--color-border);
  }

  .btn-wa:hover {
    border-color: #16A34A;
    color: #16A34A;
    background-color: #F0FDF4;
  }

  /* Hero Feature Pillars */
  .hero-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .hero-features {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  .hero-feature-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .feature-icon {
    font-size: 1.35rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-feature-item strong {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-wood);
    line-height: 1.2;
  }

  .hero-feature-item span {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  /* Hero Image Visual */
  .hero-visual {
    position: relative;
    width: 100%;
  }

  .hero-image-card {
    position: relative;
  }

  .hero-image-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: 0 12px 35px rgba(40, 29, 23, 0.12);
  }

  .hero-image-frame img {
    width: 100%;
    height: auto;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
  }

  .hero-stamp {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(30, 19, 13, 0.85);
    color: #FAF7F2;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    font-weight: 700;
    backdrop-filter: blur(4px);
    border: 1px solid rgba(250, 247, 242, 0.2);
  }

  .hero-image-badge {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    background: rgba(255, 255, 255, 0.95);
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-wood);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 4px 15px rgba(40, 29, 23, 0.1);
    backdrop-filter: blur(4px);
  }

  .badge-dot-live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #16A34A;
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.2);
  }

  /* ==========================================================================
     BEST 6 MENU GRID (1 Row 3 Cards)
     ========================================================================== */
  .section-title-wrap {
    margin-bottom: var(--space-10);
  }

  .section-heading-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-wood);
    margin-bottom: var(--space-2);
  }

  .section-heading-sub {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .best-six-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 640px) {
    .best-six-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .best-six-grid {
      grid-template-columns: repeat(3, 1fr); /* 1 Row 3 Cards */
      gap: var(--space-6);
    }
  }

  .btn-show-more {
    padding: 0.85rem 2.25rem;
    font-size: 1rem;
    border-radius: var(--radius-md);
  }

  .menu-cta-caption {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-3);
  }

  /* ==========================================================================
     CERITA NDALEM
     ========================================================================== */
  .critane-quote {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-wood);
    margin: var(--space-3) 0 var(--space-2);
  }

  .critane-sub {
    font-size: 1.125rem;
    color: var(--color-terracotta);
    font-family: var(--font-serif);
    margin-bottom: var(--space-4);
  }

  .critane-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin: var(--space-6) 0;
  }

  .divider-line {
    width: 60px;
    height: 1px;
    background-color: var(--color-border);
  }

  .divider-dot {
    color: var(--color-amber);
    font-size: 0.75rem;
  }

  .critane-desc {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: var(--space-8);
  }

  /* Final CTA */
  .section-dark {
    background-color: var(--color-wood);
    color: #FAF7F2;
  }

  .final-cta-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: #FAF7F2;
    margin-bottom: var(--space-3);
  }

  .final-cta-desc {
    font-size: var(--text-base);
    color: var(--color-text-light-muted);
    max-width: 580px;
    margin: 0 auto var(--space-8);
    line-height: 1.7;
  }
</style>
