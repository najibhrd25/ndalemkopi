---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SuasanaGrid from '../components/SuasanaGrid.astro';
---

<BaseLayout
  title="Tentang Ndalem Kopi — Critane Ndalem"
  description="Cerita, filosofi, dan suasana di balik Ndalem Kopi. Sebuah rumah sederhana di mana Anda bisa ngopi, mangan, dan bercengkerama dalam ketenangan suasana Jawa kontemporer."
>
  <!-- ==========================================
       HERO / INTRO SECTION
       ========================================== -->
  <section class="about-hero-section" aria-label="Pengantar Critane Ndalem">
    <div class="container text-center">
      <span class="eyebrow">CRITANE NDALEM</span>
      <h1 class="font-serif about-hero-quote">
        “Ndalem iku papan kanggo mulih.”
      </h1>
      <p class="about-hero-sub">
        Papan sing nampa sapa wae kanthi ati tulus, hawane adhem, lan suguhane ngelingake rasa omah.
      </p>

      <div class="about-hero-divider">
        <span class="divider-line"></span>
        <span class="divider-dot">✦</span>
        <span class="divider-line"></span>
      </div>
    </div>
  </section>

  <!-- ==========================================
       CERITA NDALEM (NARRATIVE) - CENTERED & EDITORIAL
       ========================================== -->
  <section class="section section-surface" aria-label="Kisah Ndalem Kopi">
    <div class="container">
      <div class="story-wrapper text-center">
        <span class="eyebrow">AWAL MULA</span>
        <h2 class="story-title">Saka Ruang Sederhana Tumuju Paseduluran</h2>
        
        <div class="story-text-centered">
          <p>
            Tembung <em>Ndalem</em> tegese omah utawa papan dunung sing kebak katentreman. Ndalem Kopi lair saka kekarepan prasaja: nyiptakake panggonan sing kepenak kanggo mandheg sedhela saka gumerite urip kutha sing serba kesusu.
          </p>
          <p>
            Ing kene, saben cangkir kopi tubruk diseduh kanthi teliti, wedangan rempah digodhog nganggo rimpang pilihan, lan sego blendi diracik manut resep warisan pawon Jawa. Ora mung babagan rasa, nanging uga babagan angeting swasana nalika lungguh bareng ing sangisore pendopo kayu.
          </p>
          <p>
            Ndalem Kopi ora mung dadi warung kopi, nanging dadi ruang temu kanggo ngraketake paseduluran, nuduhake crita, lan nemokake katentreman rasa.
          </p>
        </div>

        <div class="story-visual-wrap">
          <div class="picture-frame story-image-frame">
            <img
              src="/images/hero/hero-ndalem.webp"
              alt="Pendopo Ndalem Kopi dalam balutan nuansa kayu jati hangat"
              width="1000"
              height="562"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       FILOSOFI (3 NILAI UTAMA)
       ========================================== -->
  <section class="section" aria-label="Filosofi Ndalem Kopi">
    <div class="container">
      <SectionHeading
        eyebrow="TETELU PILAR"
        title="Filosofi Ndalem"
        subtitle="Telung prinsip sing tansah dadi pathokan ing saben racikan lan sesambungan."
        align="center"
      />

      <div class="philosophy-grid">
        <!-- Pilar 1: Ngopi -->
        <div class="philosophy-card text-center">
          <div class="philosophy-icon">
            <span class="icon-number">01</span>
          </div>
          <h3 class="philosophy-name">Ngopi</h3>
          <p class="philosophy-desc">
            Nyruput kopi tubruk racikan mantap lan angete wedang rempah alami sing nyegerake pikiran lan nguripake swasana.
          </p>
        </div>

        <!-- Pilar 2: Mangan -->
        <div class="philosophy-card text-center">
          <div class="philosophy-icon">
            <span class="icon-number">02</span>
          </div>
          <h3 class="philosophy-name">Mangan</h3>
          <p class="philosophy-desc">
            Ngrasakake olahan sego blendi, bakmi jowo, lan lawuh sedap saka pawon tradisional sing ndadekake kangen omah ketamban.
          </p>
        </div>

        <!-- Pilar 3: Crita -->
        <div class="philosophy-card text-center">
          <div class="philosophy-icon">
            <span class="icon-number">03</span>
          </div>
          <h3 class="philosophy-name">Crita</h3>
          <p class="philosophy-desc">
            Mbagi kabungahan lan uneg-uneg bareng kanca, kulawarga, utawa sedulur anyar tanpa perlu diwatesi wektu sing kesusu.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       SUASANA RUANG
       ========================================== -->
  <section class="section section-surface" aria-label="Suasana Ruang">
    <div class="container">
      <SectionHeading
        eyebrow="SWASANA PENDOPO"
        title="Ruang Ayem ing Tengah Taman"
        subtitle="Hawa seger, semilir angin taman, lan unine godhong sing ngancani obrolan santaimu."
        align="center"
      />

      <SuasanaGrid />
    </div>
  </section>

  <!-- ==========================================
       FINAL CTA
       ========================================== -->
  <section class="section section-dark text-center" aria-label="Ayo Mampir">
    <div class="container-narrow">
      <span class="eyebrow">SUGENG RAWUH</span>
      <h2 class="final-cta-title">Mampir nang Ndalem Kopi</h2>
      <p class="final-cta-desc">
        Pintu pendopo kami tansah tinarbuka kanggo panjenengan. Mangga pirsani menu lengkap lan tentukna pilihanmu.
      </p>
      <div class="final-cta-action">
        <a href="/menu" class="btn btn-light">
          Delok Suguhan Menu
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
    background-color: var(--color-bg-base);
  }

  .about-hero-quote {
    font-size: var(--text-3xl);
    font-style: italic;
    color: var(--color-wood);
    line-height: 1.3;
    max-width: 780px;
    margin: 0 auto var(--space-4) auto;
  }

  @media (min-width: 768px) {
    .about-hero-quote {
      font-size: var(--text-5xl);
    }
  }

  .about-hero-sub {
    font-size: var(--text-lg);
    color: var(--color-terracotta);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .about-hero-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .divider-line {
    width: 60px;
    height: 1px;
    background-color: var(--color-border);
  }

  .divider-dot {
    color: var(--color-amber);
    font-size: var(--text-xs);
  }

  /* Story Centered Wrapper */
  .story-wrapper {
    max-width: 820px;
    margin: 0 auto;
  }

  .story-title {
    font-size: var(--text-3xl);
    font-weight: 600;
    margin-bottom: var(--space-6);
    line-height: 1.25;
  }

  @media (min-width: 768px) {
    .story-title {
      font-size: var(--text-4xl);
    }
  }

  .story-text-centered {
    margin-bottom: var(--space-10);
    text-align: center;
  }

  .story-text-centered p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.85;
    margin-bottom: var(--space-5);
    text-align: center;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 768px) {
    .story-text-centered p {
      font-size: var(--text-lg);
    }
  }

  .story-text-centered p:last-child {
    margin-bottom: 0;
  }

  .story-visual-wrap {
    max-width: 800px;
    margin: 0 auto;
  }

  .story-image-frame {
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    aspect-ratio: 16 / 9;
  }

  /* Philosophy Grid */
  .philosophy-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .philosophy-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }

  .philosophy-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .philosophy-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-terracotta);
    box-shadow: var(--shadow-card);
  }

  .philosophy-icon {
    margin-bottom: var(--space-4);
  }

  .icon-number {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-terracotta);
    background-color: var(--color-amber-soft);
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
  }

  .philosophy-name {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-wood);
    margin-bottom: var(--space-2);
  }

  .philosophy-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Final CTA */
  .final-cta-title {
    font-size: var(--text-3xl);
    font-weight: 600;
    color: var(--color-text-light);
    margin-bottom: var(--space-3);
  }

  @media (min-width: 768px) {
    .final-cta-title {
      font-size: var(--text-4xl);
    }
  }

  .final-cta-desc {
    font-size: var(--text-base);
    color: var(--color-text-light-muted);
    margin-bottom: var(--space-6);
    line-height: 1.6;
  }

  .final-cta-action {
    display: flex;
    justify-content: center;
  }
</style>
