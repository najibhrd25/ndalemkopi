---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { menuItems, CATEGORIES } from '../../data/menu';

const initialMenuJson = JSON.stringify(menuItems);
const categoriesJson = JSON.stringify(CATEGORIES);
---

<AdminLayout title="Pawon Admin — Kelola Menu Ndalem Kopi" activeNav="dashboard">
  <!-- ===================================================================
       1. BENTO GRID SUMMARY CARDS (Focus on Menu Metrics)
       =================================================================== -->
  <div class="ds-kpi-grid" id="dashboard-kpis">
    <!-- Card 1: Total Menu -->
    <div class="ds-kpi-card">
      <div class="ds-kpi-line-1">
        <span>TOTAL MENU TERDAFTAR</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-terracotta)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
      </div>
      <div class="ds-kpi-line-2" id="kpi-total-count">
        {menuItems.length}
      </div>
      <div class="ds-kpi-line-3">
        <span class="ds-badge ds-badge-success">Aktif</span>
        <span>Menu siap disajikan di Ndalem</span>
      </div>
    </div>

    <!-- Card 2: Minuman -->
    <div class="ds-kpi-card">
      <div class="ds-kpi-line-1">
        <span>OMBENAN (MINUMAN)</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-terracotta)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
          <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
          <line x1="6" y1="1" x2="6" y2="4"></line>
          <line x1="10" y1="1" x2="10" y2="4"></line>
        </svg>
      </div>
      <div class="ds-kpi-line-2" id="kpi-minuman-count">
        {menuItems.filter(i => i.type === 'minuman').length}
      </div>
      <div class="ds-kpi-line-3">
        <span class="ds-badge ds-badge-info">Kopi & Wedangan</span>
        <span>Seduhan panas, es, jus & herbal</span>
      </div>
    </div>

    <!-- Card 3: Makanan -->
    <div class="ds-kpi-card">
      <div class="ds-kpi-line-1">
        <span>PANGANAN (MAKANAN)</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-terracotta)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a10 10 0 0 0-10 10c0 5.523 4.477 10 10 10s10-4.477 10-10A10 10 0 0 0 12 2z"></path>
          <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
        </svg>
      </div>
      <div class="ds-kpi-line-2" id="kpi-makanan-count">
        {menuItems.filter(i => i.type === 'makanan').length}
      </div>
      <div class="ds-kpi-line-3">
        <span class="ds-badge ds-badge-info">Sajian Pawon</span>
        <span>Sego blendi, serba 10K, snack</span>
      </div>
    </div>
  </div>

  <!-- ===================================================================
       2. MANAJEMEN MENU: FILTER & DATA TABLE (Fokus Input Menu)
       =================================================================== -->
  <section class="ds-card" id="section-menu-table" aria-label="Tabel Manajemen Menu">
    <div class="ds-card-header">
      <div class="ds-card-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-terracotta)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        <span style="font-family:var(--font-heading); font-size:1.125rem;">Daftar Menu Pawon Ndalem</span>
        <span class="ds-badge ds-badge-neutral" id="table-filtered-badge">Semua Menu</span>
      </div>

      <button type="button" class="btn btn-primary" id="btn-add-menu-main" onclick="window.openAddModal && window.openAddModal()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>+ Input Menu Baru</span>
      </button>
    </div>

    <!-- Filter & Search Toolbar -->
    <div style="display:flex; flex-wrap:wrap; gap:0.75rem; align-items:center; margin-bottom:1rem; justify-content:space-between;">
      <!-- Type Filter Tabs -->
      <div style="display:flex; gap:0.35rem; background-color:#FAF7F2; padding:4px; border-radius:var(--radius-md); border:1px solid var(--ds-border-default);">
        <button type="button" class="ds-filter-tab active" data-filter-type="all">Semua</button>
        <button type="button" class="ds-filter-tab" data-filter-type="minuman">Ombenan (Minuman)</button>
        <button type="button" class="ds-filter-tab" data-filter-type="makanan">Panganan (Makanan)</button>
      </div>

      <div style="display:flex; gap:0.5rem; flex-wrap:wrap; flex:1; max-width:600px; justify-content:flex-end;">
        <!-- Category Filter -->
        <select id="filter-category" class="ds-select" style="width:180px; height:38px; font-size:0.8125rem;">
          <option value="all">Semua Kategori</option>
          {CATEGORIES.map(cat => (
            <option value={cat.id}>{cat.name}</option>
          ))}
        </select>

        <!-- Status Filter -->
        <select id="filter-status" class="ds-select" style="width:130px; height:38px; font-size:0.8125rem;">
          <option value="all">Semua Status</option>
          <option value="Tersedia">Tersedia</option>
          <option value="Habis">Habis</option>
        </select>

        <!-- Search Bar -->
        <div style="position:relative; width:200px;">
          <input
            type="text"
            id="search-menu-input"
            class="ds-input"
            placeholder="Cari nama menu..."
            style="height:38px; font-size:0.8125rem; padding-left:2rem;"
          />
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--ds-text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position:absolute; left:0.65rem; top:50%; transform:translateY(-50%); pointer-events:none;">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
      </div>
    </div>

    <!-- Data Table -->
    <div class="ds-table-wrapper">
      <table class="ds-table" id="menu-data-table">
        <thead>
          <tr>
            <th style="width:64px; text-align:center;">FOTO</th>
            <th>NAMA MENU</th>
            <th>TIPE</th>
            <th>KATEGORI</th>
            <th style="text-align:right;">HARGA</th>
            <th style="text-align:center;">STATUS</th>
            <th>HIGHLIGHT</th>
            <th style="text-align:right; width:140px;">AKSI</th>
          </tr>
        </thead>
        <tbody id="menu-table-body">
          <!-- Populated by JavaScript -->
        </tbody>
      </table>
    </div>

    <!-- Empty State -->
    <div id="table-empty-state" style="display:none; padding:3rem 1rem; text-align:center; color:var(--ds-text-muted);">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto 0.75rem auto; opacity:0.6;">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <div style="font-weight:600; color:var(--ds-text-primary); font-size:0.9375rem;">Tidak ada menu yang sesuai</div>
      <p style="font-size:0.8125rem; margin-top:4px;">Coba ubah kata kunci pencarian atau reset filter.</p>
    </div>

    <!-- Table Footer / Count -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:1rem; font-size:0.8125rem; color:var(--ds-text-muted); flex-wrap:wrap; gap:0.5rem;">
      <div>Menampilkan <strong id="visible-count">0</strong> dari <span id="total-count">0</span> menu</div>
      <div style="display:flex; gap:0.5rem;">
        <button type="button" class="btn btn-secondary" id="btn-export-json" style="height:32px; font-size:0.75rem; padding:0 0.65rem;">
          Ekspor JSON Backup
        </button>
        <button type="button" class="btn btn-secondary" id="btn-reset-default" style="height:32px; font-size:0.75rem; padding:0 0.65rem;">
          Reset Data Awal
        </button>
      </div>
    </div>
  </section>

  <!-- ===================================================================
       3. MODAL: INPUT / EDIT MENU (With Dedicated Photo Space)
       =================================================================== -->
  <div class="ds-modal-backdrop" id="modal-menu-form" style="display:none;">
    <div class="ds-modal" role="dialog" aria-labelledby="modal-form-title">
      <div class="ds-modal-header">
        <h3 class="ds-modal-title" id="modal-form-title">Input Menu Baru</h3>
        <button type="button" class="ds-modal-close" id="btn-close-modal" aria-label="Tutup Dialog">✕</button>
      </div>

      <form id="form-menu-item">
        <div class="ds-modal-body">
          <input type="hidden" id="form-item-id" />

          <!-- Nama Menu -->
          <div class="ds-form-group">
            <label for="form-item-name" class="ds-label ds-label-required">Nama Menu</label>
            <input type="text" id="form-item-name" class="ds-input" required placeholder="Contoh: Kopi Tubruk Ndalem / Sego Blendi" />
          </div>

          <!-- Tipe & Kategori -->
          <div class="ds-form-row">
            <div class="ds-form-group">
              <label for="form-item-type" class="ds-label ds-label-required">Tipe Menu</label>
              <select id="form-item-type" class="ds-select" required>
                <option value="minuman">Ombenan (Minuman)</option>
                <option value="makanan">Panganan (Makanan)</option>
              </select>
            </div>

            <div class="ds-form-group">
              <label for="form-item-category" class="ds-label ds-label-required">Kategori</label>
              <select id="form-item-category" class="ds-select" required>
                <!-- Populated dynamically based on type -->
              </select>
            </div>
          </div>

          <!-- Harga & Status -->
          <div class="ds-form-row">
            <div class="ds-form-group">
              <label for="form-item-price" class="ds-label ds-label-required">Harga (Rp)</label>
              <input type="number" id="form-item-price" class="ds-input" required min="0" step="500" placeholder="5000" />
              <div class="ds-helper" id="form-price-preview">Rp5.000</div>
            </div>

            <div class="ds-form-group">
              <label for="form-item-status" class="ds-label">Status Ketersediaan</label>
              <select id="form-item-status" class="ds-select">
                <option value="Tersedia">Tersedia (Siap Pesan)</option>
                <option value="Habis">Habis (Kosong)</option>
              </select>
            </div>
          </div>

          <!-- DEDICATED PHOTO SPACE -->
          <div class="ds-form-group">
            <label class="ds-label">Foto Menu (Space Foto Terintegrasi)</label>
            <div class="ds-photo-field-wrap">
              <!-- Live Photo Preview Box -->
              <div class="ds-photo-preview-slot" id="photo-preview-box">
                <div class="ds-photo-preview-empty" id="photo-preview-empty">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:2px; opacity:0.6;">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                  <span>Belum Ada Foto</span>
                </div>
                <img src="" id="photo-preview-img" alt="Preview Foto Menu" style="display:none;" />
              </div>

              <!-- Photo Controls -->
              <div class="ds-photo-inputs">
                <input
                  type="text"
                  id="form-item-image"
                  class="ds-input"
                  placeholder="URL Foto (Google Drive, WebP, Unsplash, dsb)"
                  style="margin-bottom:6px;"
                />

                <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                  <label class="btn btn-secondary" style="height:32px; padding:0 0.75rem; font-size:0.75rem; cursor:pointer;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="17 8 12 3 7 8"></polyline>
                      <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    <span>Upload Foto dari Komputer</span>
                    <input type="file" id="form-file-input" accept="image/*" style="display:none;" />
                  </label>

                  <button type="button" class="btn btn-secondary" id="btn-clear-photo" style="height:32px; padding:0 0.65rem; font-size:0.75rem; color:#B91C1C;">
                    Hapus Foto
                  </button>
                </div>
                <div class="ds-helper">Foto akan langsung ditampilkan di kartu menu publik & tabel admin.</div>
              </div>
            </div>
          </div>

          <!-- Deskripsi Singkat -->
          <div class="ds-form-group">
            <label for="form-item-desc" class="ds-label">Deskripsi Menu</label>
            <textarea id="form-item-desc" class="ds-textarea" placeholder="Tuliskan rasa khas atau keunikan racikan sajian ini..."></textarea>
          </div>

          <!-- Catatan / Opsi Pilihan -->
          <div class="ds-form-group">
            <label for="form-item-notes" class="ds-label">Catatan / Opsi Tambahan</label>
            <input type="text" id="form-item-notes" class="ds-input" placeholder="Contoh: Pilihan Gula: Biasa (+0) / Tropicana (+1.000)" />
          </div>

          <!-- Checkbox Signature & Favorit -->
          <div style="display:flex; gap:1.5rem; margin-top:0.75rem; padding-top:0.75rem; border-top:1px solid var(--ds-border-subtle);">
            <label style="display:flex; align-items:center; gap:0.45rem; font-size:0.875rem; cursor:pointer; color:var(--ds-text-primary);">
              <input type="checkbox" id="form-item-signature" style="width:16px; height:16px; accent-color:var(--color-wood);" />
              <span>Menu Signature Ndalem</span>
            </label>

            <label style="display:flex; align-items:center; gap:0.45rem; font-size:0.875rem; cursor:pointer; color:var(--ds-text-primary);">
              <input type="checkbox" id="form-item-favorite" style="width:16px; height:16px; accent-color:var(--color-terracotta);" />
              <span>Menu Favorit Pengunjung</span>
            </label>
          </div>
        </div>

        <div class="ds-modal-footer">
          <button type="button" class="btn btn-secondary" id="btn-cancel-modal">Batal</button>
          <button type="submit" class="btn btn-primary" id="btn-save-menu">Simpan Menu</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ===================================================================
       4. MODAL: KONFIRMASI HAPUS
       =================================================================== -->
  <div class="ds-modal-backdrop" id="modal-delete-confirm" style="display:none;">
    <div class="ds-modal" style="max-width:440px;">
      <div class="ds-modal-header">
        <h3 class="ds-modal-title" style="color:#991B1B;">Hapus Menu</h3>
        <button type="button" class="ds-modal-close" id="btn-close-delete-modal">✕</button>
      </div>
      <div class="ds-modal-body">
        <p style="font-size:0.875rem; color:var(--ds-text-primary);" id="delete-confirm-text">
          Apakah Anda yakin ingin menghapus menu ini?
        </p>
      </div>
      <div class="ds-modal-footer">
        <button type="button" class="btn btn-secondary" id="btn-cancel-delete">Batal</button>
        <button type="button" class="btn btn-primary" id="btn-confirm-delete" style="background-color:#B91C1C; border-color:#B91C1C;">Hapus Sekarang</button>
      </div>
    </div>
  </div>

  <!-- Toast Notification Bar -->
  <div id="ds-toast" style="position:fixed; bottom:1.5rem; right:1.5rem; background-color:var(--color-wood); color:#FAF7F2; padding:0.75rem 1.25rem; border-radius:var(--radius-md); font-size:0.875rem; display:none; align-items:center; gap:0.5rem; z-index:2000; box-shadow:0 10px 25px rgba(40,29,23,0.25);">
    <span id="toast-message">Pesan sukses</span>
  </div>

  <style>
    .ds-filter-tab {
      background: transparent;
      border: none;
      padding: 0.35rem 0.85rem;
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--ds-text-secondary);
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all var(--transition-fast);
    }
    .ds-filter-tab:hover {
      color: var(--color-wood);
      background-color: var(--ds-bg-muted);
    }
    .ds-filter-tab.active {
      background-color: #FFFFFF;
      color: var(--color-wood);
      font-weight: 600;
      box-shadow: 0 1px 2px rgba(40, 29, 23, 0.06);
    }
    .ds-table-thumb {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-sm);
      object-fit: cover;
      display: block;
      border: 1px solid var(--ds-border-default);
      background-color: var(--ds-bg-muted);
    }
    .ds-table-thumb-empty {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-sm);
      background-color: var(--ds-bg-muted);
      border: 1px dashed var(--ds-border-default);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-terracotta);
      font-size: 0.625rem;
      text-align: center;
    }
  </style>

  <!-- Client JavaScript for Admin Menu Management -->
  <script is:inline define:vars={{ initialMenuJson, categoriesJson }}>
    const STORAGE_KEY = 'ndalem_kopi_menu_items';

    const defaultItems = JSON.parse(initialMenuJson);
    const categories = JSON.parse(categoriesJson);

    // State
    let items = [];
    let activeTypeFilter = 'all';
    let activeCategoryFilter = 'all';
    let activeStatusFilter = 'all';
    let searchQuery = '';
    let pendingDeleteId = null;

    // Load Items from LocalStorage or default
    function loadItems() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          items = JSON.parse(saved);
        } else {
          items = [...defaultItems];
          saveItemsLocal();
        }
      } catch (e) {
        items = [...defaultItems];
      }
      updateKpis();
      renderTable();
    }

    function saveItemsLocal() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
      } catch (e) {
        console.error('Gagal menyimpan ke localStorage', e);
      }
    }

    function formatRupiah(num) {
      return 'Rp' + Number(num || 0).toLocaleString('id-ID');
    }

    function showToast(msg, isError = false) {
      const toast = document.getElementById('ds-toast');
      const toastMsg = document.getElementById('toast-message');
      if (toast && toastMsg) {
        toastMsg.textContent = msg;
        toast.style.backgroundColor = isError ? '#991B1B' : '#2B1C14';
        toast.style.display = 'flex';
        setTimeout(() => {
          toast.style.display = 'none';
        }, 3500);
      }
    }

    function updateKpis() {
      const totalCount = items.length;
      const minumanCount = items.filter(i => (i.type || '').toLowerCase() === 'minuman').length;
      const makananCount = items.filter(i => (i.type || '').toLowerCase() === 'makanan').length;

      const elTotal = document.getElementById('kpi-total-count');
      const elMinuman = document.getElementById('kpi-minuman-count');
      const elMakanan = document.getElementById('kpi-makanan-count');

      if (elTotal) elTotal.textContent = totalCount;
      if (elMinuman) elMinuman.textContent = minumanCount;
      if (elMakanan) elMakanan.textContent = makananCount;

      const elTotalFoot = document.getElementById('total-count');
      if (elTotalFoot) elTotalFoot.textContent = totalCount;
    }

    function filterItems() {
      return items.filter(item => {
        // Type filter
        if (activeTypeFilter !== 'all' && (item.type || '').toLowerCase() !== activeTypeFilter) {
          return false;
        }
        // Category filter
        if (activeCategoryFilter !== 'all' && item.category !== activeCategoryFilter) {
          return false;
        }
        // Status filter
        if (activeStatusFilter !== 'all' && (item.status || 'Tersedia') !== activeStatusFilter) {
          return false;
        }
        // Search query
        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          const nameMatch = (item.name || '').toLowerCase().includes(q);
          const descMatch = (item.description || '').toLowerCase().includes(q);
          const catMatch = (item.categoryName || '').toLowerCase().includes(q);
          if (!nameMatch && !descMatch && !catMatch) return false;
        }
        return true;
      });
    }

    function renderTable() {
      const tbody = document.getElementById('menu-table-body');
      const emptyState = document.getElementById('table-empty-state');
      const visibleCountEl = document.getElementById('visible-count');
      if (!tbody) return;

      const filtered = filterItems();
      if (visibleCountEl) visibleCountEl.textContent = filtered.length;

      if (filtered.length === 0) {
        tbody.innerHTML = '';
        if (emptyState) emptyState.style.display = 'block';
        return;
      }

      if (emptyState) emptyState.style.display = 'none';

      let html = '';
      filtered.forEach(item => {
        const itemType = (item.type || 'minuman').toLowerCase();
        const typeBadge = itemType === 'minuman' 
          ? '<span class="ds-badge ds-badge-info">Minuman</span>'
          : '<span class="ds-badge ds-badge-neutral">Makanan</span>';

        const status = item.status || 'Tersedia';
        const statusBadge = status === 'Tersedia'
          ? `<button type="button" class="ds-badge ds-badge-success" onclick="window.toggleMenuStatus('${item.id}')" title="Klik untuk ubah status">● Tersedia</button>`
          : `<button type="button" class="ds-badge ds-badge-danger" onclick="window.toggleMenuStatus('${item.id}')" title="Klik untuk ubah status">✕ Habis</button>`;

        let badges = '';
        if (item.signature) badges += '<span class="ds-badge ds-badge-warning" style="margin-right:3px;">Signature</span>';
        if (item.favorite) badges += '<span class="ds-badge ds-badge-info">Favorit</span>';
        if (!badges) badges = '<span style="color:var(--ds-text-muted); font-size:0.75rem;">—</span>';

        // Photo slot render
        const photoCol = item.image 
          ? `<img src="${item.image}" alt="${item.name}" class="ds-table-thumb" loading="lazy" />`
          : `<div class="ds-table-thumb-empty" title="Belum ada foto">
               <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                 <path d="M12 2a10 10 0 0 0-10 10c0 5.523 4.477 10 10 10s10-4.477 10-10A10 10 0 0 0 12 2z"></path>
               </svg>
             </div>`;

        html += `
          <tr data-id="${item.id}">
            <td style="text-align:center;">${photoCol}</td>
            <td>
              <div style="font-weight:600; color:var(--color-wood); font-size:0.9375rem;">${item.name}</div>
              ${item.notes ? `<div style="font-size:0.75rem; color:var(--color-amber);">${item.notes}</div>` : ''}
              ${item.description ? `<div style="font-size:0.75rem; color:var(--ds-text-muted); max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${item.description}</div>` : ''}
            </td>
            <td>${typeBadge}</td>
            <td style="font-size:0.8125rem; color:var(--ds-text-secondary);">${item.categoryName || item.category || '—'}</td>
            <td style="text-align:right; font-weight:700; color:var(--color-wood); font-size:0.9375rem;">${formatRupiah(item.price)}</td>
            <td style="text-align:center;">${statusBadge}</td>
            <td>${badges}</td>
            <td style="text-align:right; white-space:nowrap;">
              <button type="button" class="ds-action-btn" onclick="window.editMenuItem('${item.id}')">Edit</button>
              <button type="button" class="ds-action-btn ds-action-btn-danger" onclick="window.openDeleteModal('${item.id}')">Hapus</button>
            </td>
          </tr>
        `;
      });

      tbody.innerHTML = html;
    }

    // Toggle Status Tersedia <-> Habis
    window.toggleMenuStatus = function(id) {
      const idx = items.findIndex(i => i.id === id);
      if (idx !== -1) {
        items[idx].status = items[idx].status === 'Habis' ? 'Tersedia' : 'Habis';
        saveItemsLocal();
        renderTable();
        showToast(`Status "${items[idx].name}" diubah: ${items[idx].status}`);
      }
    };

    // Populate Category Dropdown based on Type
    function updateCategoryDropdown(selectedType, currentCatId = '') {
      const select = document.getElementById('form-item-category');
      if (!select) return;

      const filteredCats = categories.filter(c => c.type === selectedType);
      select.innerHTML = '';
      filteredCats.forEach(cat => {
        const opt = document.createElement('option');
        opt.value = cat.id;
        opt.textContent = cat.name;
        if (cat.id === currentCatId) opt.selected = true;
        select.appendChild(opt);
      });
    }

    // Photo Preview Handlers
    function updatePhotoPreview(url) {
      const img = document.getElementById('photo-preview-img');
      const empty = document.getElementById('photo-preview-empty');
      if (url && url.trim()) {
        img.src = url;
        img.style.display = 'block';
        empty.style.display = 'none';
      } else {
        img.src = '';
        img.style.display = 'none';
        empty.style.display = 'flex';
      }
    }

    // Open Add Menu Modal
    function openAddModal() {
      document.getElementById('modal-form-title').textContent = 'Input Menu Baru';
      document.getElementById('form-item-id').value = '';
      document.getElementById('form-item-name').value = '';
      document.getElementById('form-item-type').value = 'minuman';
      updateCategoryDropdown('minuman');
      document.getElementById('form-item-price').value = '5000';
      document.getElementById('form-price-preview').textContent = formatRupiah(5000);
      document.getElementById('form-item-status').value = 'Tersedia';
      document.getElementById('form-item-image').value = '';
      document.getElementById('form-item-desc').value = '';
      document.getElementById('form-item-notes').value = '';
      document.getElementById('form-item-signature').checked = false;
      document.getElementById('form-item-favorite').checked = false;
      updatePhotoPreview('');

      document.getElementById('modal-menu-form').style.display = 'flex';
    }
    window.openAddModal = openAddModal;

    // Open Edit Menu Modal
    window.editMenuItem = function(id) {
      const item = items.find(i => i.id === id);
      if (!item) return;

      document.getElementById('modal-form-title').textContent = 'Edit Menu: ' + item.name;
      document.getElementById('form-item-id').value = item.id;
      document.getElementById('form-item-name').value = item.name || '';
      const type = (item.type || 'minuman').toLowerCase();
      document.getElementById('form-item-type').value = type;
      updateCategoryDropdown(type, item.category);
      document.getElementById('form-item-price').value = item.price || 0;
      document.getElementById('form-price-preview').textContent = formatRupiah(item.price || 0);
      document.getElementById('form-item-status').value = item.status || 'Tersedia';
      document.getElementById('form-item-image').value = item.image || '';
      document.getElementById('form-item-desc').value = item.description || '';
      document.getElementById('form-item-notes').value = item.notes || '';
      document.getElementById('form-item-signature').checked = Boolean(item.signature);
      document.getElementById('form-item-favorite').checked = Boolean(item.favorite);
      updatePhotoPreview(item.image || '');

      document.getElementById('modal-menu-form').style.display = 'flex';
    };

    // Open Delete Modal
    window.openDeleteModal = function(id) {
      const item = items.find(i => i.id === id);
      if (!item) return;
      pendingDeleteId = id;
      const textEl = document.getElementById('delete-confirm-text');
      if (textEl) {
        textEl.innerHTML = `Apakah Anda yakin ingin menghapus <strong>"${item.name}"</strong> dari daftar menu?`;
      }
      document.getElementById('modal-delete-confirm').style.display = 'flex';
    };

    // Setup Event Listeners
    document.addEventListener('DOMContentLoaded', () => {
      loadItems();

      // Type tabs filter
      document.querySelectorAll('.ds-filter-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.ds-filter-tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          activeTypeFilter = tab.dataset.filterType || 'all';

          // Update Category dropdown
          const catSelect = document.getElementById('filter-category');
          if (catSelect) {
            catSelect.innerHTML = '<option value="all">Semua Kategori</option>';
            const relevantCats = activeTypeFilter === 'all' 
              ? categories 
              : categories.filter(c => c.type === activeTypeFilter);
            relevantCats.forEach(c => {
              const opt = document.createElement('option');
              opt.value = c.id;
              opt.textContent = c.name;
              catSelect.appendChild(opt);
            });
            activeCategoryFilter = 'all';
          }

          const badgeEl = document.getElementById('table-filtered-badge');
          if (badgeEl) {
            badgeEl.textContent = activeTypeFilter === 'all' ? 'Semua Menu' : (activeTypeFilter === 'minuman' ? 'Ombenan (Minuman)' : 'Panganan (Makanan)');
          }

          renderTable();
        });
      });

      // Filter Toolbar events
      document.getElementById('filter-category')?.addEventListener('change', (e) => {
        activeCategoryFilter = e.target.value;
        renderTable();
      });

      document.getElementById('filter-status')?.addEventListener('change', (e) => {
        activeStatusFilter = e.target.value;
        renderTable();
      });

      document.getElementById('search-menu-input')?.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim();
        renderTable();
      });

      // Add Menu Buttons
      document.getElementById('btn-add-menu-topbar')?.addEventListener('click', openAddModal);
      document.getElementById('btn-add-menu-main')?.addEventListener('click', openAddModal);
      document.getElementById('nav-btn-add-menu')?.addEventListener('click', openAddModal);

      // Close Modal Form
      const closeModal = () => {
        document.getElementById('modal-menu-form').style.display = 'none';
      };
      document.getElementById('btn-close-modal')?.addEventListener('click', closeModal);
      document.getElementById('btn-cancel-modal')?.addEventListener('click', closeModal);

      // Modal Type Change -> Update Categories
      document.getElementById('form-item-type')?.addEventListener('change', (e) => {
        updateCategoryDropdown(e.target.value);
      });

      // Price input live preview
      document.getElementById('form-item-price')?.addEventListener('input', (e) => {
        document.getElementById('form-price-preview').textContent = formatRupiah(e.target.value);
      });

      // Image URL live preview
      document.getElementById('form-item-image')?.addEventListener('input', (e) => {
        updatePhotoPreview(e.target.value);
      });

      // Clear photo button
      document.getElementById('btn-clear-photo')?.addEventListener('click', () => {
        document.getElementById('form-item-image').value = '';
        updatePhotoPreview('');
      });

      // File upload to Data URL preview
      document.getElementById('form-file-input')?.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (uploadEvent) => {
            const dataUrl = uploadEvent.target?.result;
            document.getElementById('form-item-image').value = dataUrl;
            updatePhotoPreview(dataUrl);
            showToast('Foto lokal berhasil dimuat!');
          };
          reader.readAsDataURL(file);
        }
      });

      // Form Submit (Save / Edit)
      document.getElementById('form-menu-item')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const id = document.getElementById('form-item-id').value;
        const name = document.getElementById('form-item-name').value.trim();
        const type = document.getElementById('form-item-type').value;
        const catSelect = document.getElementById('form-item-category');
        const categoryId = catSelect.value;
        const categoryName = catSelect.options[catSelect.selectedIndex]?.text || '';
        const price = Number(document.getElementById('form-item-price').value || 0);
        const status = document.getElementById('form-item-status').value;
        const image = document.getElementById('form-item-image').value.trim();
        const description = document.getElementById('form-item-desc').value.trim();
        const notes = document.getElementById('form-item-notes').value.trim();
        const signature = document.getElementById('form-item-signature').checked;
        const favorite = document.getElementById('form-item-favorite').checked;

        if (!name) {
          alert('Nama menu wajib diisi');
          return;
        }

        if (id) {
          // Update
          const idx = items.findIndex(i => i.id === id);
          if (idx !== -1) {
            items[idx] = {
              ...items[idx],
              name,
              type,
              category: categoryId,
              categoryName,
              price,
              status,
              image,
              description,
              notes,
              signature,
              favorite,
              updatedAt: new Date().toISOString()
            };
            saveItemsLocal();
            renderTable();
            updateKpis();
            closeModal();
            showToast(`Menu "${name}" berhasil diperbarui!`);
          }
        } else {
          // Create New
          const newId = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') + '-' + Date.now().toString().slice(-4);
          const newItem = {
            id: newId,
            name,
            type,
            category: categoryId,
            categoryName,
            price,
            status,
            image,
            description,
            notes,
            signature,
            favorite,
            updatedAt: new Date().toISOString()
          };
          items.unshift(newItem);
          saveItemsLocal();
          renderTable();
          updateKpis();
          closeModal();
          showToast(`Menu "${name}" berhasil ditambahkan!`);
        }
      });

      // Delete confirmation
      const closeDeleteModal = () => {
        document.getElementById('modal-delete-confirm').style.display = 'none';
        pendingDeleteId = null;
      };
      document.getElementById('btn-close-delete-modal')?.addEventListener('click', closeDeleteModal);
      document.getElementById('btn-cancel-delete')?.addEventListener('click', closeDeleteModal);

      document.getElementById('btn-confirm-delete')?.addEventListener('click', () => {
        if (!pendingDeleteId) return;
        const target = items.find(i => i.id === pendingDeleteId);
        items = items.filter(i => i.id !== pendingDeleteId);
        saveItemsLocal();
        renderTable();
        updateKpis();
        closeDeleteModal();
        if (target) {
          showToast(`Menu "${target.name}" berhasil dihapus`);
        }
      });

      // Export JSON
      document.getElementById('btn-export-json')?.addEventListener('click', () => {
        const blob = new Blob([JSON.stringify(items, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Ndalem_Kopi_Menu_${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast('File JSON menu berhasil diunduh!');
      });

      // Reset to default
      document.getElementById('btn-reset-default')?.addEventListener('click', () => {
        if (confirm('Kembalikan seluruh data menu ke bawaan awal Ndalem Kopi?')) {
          items = [...defaultItems];
          saveItemsLocal();
          renderTable();
          updateKpis();
          showToast('Data berhasil di-reset ke versi bawaan!');
        }
      });
    });
  </script>
</AdminLayout>
