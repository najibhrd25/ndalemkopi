---
const currentYear = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Philosophy -->
      <div class="footer-col-brand">
        <h3 class="footer-title">Ndalem Kopi</h3>
        <p class="footer-text">
          Papan kanggo mulih, ngopi, mangan, lan crita tanpa perlu kesusu. Sugeng rawuh ing pendopo Ndalem Kopi.
        </p>
        <div class="footer-badge">
          <span class="badge badge-signature">Est. Tradisi Rasa Jawa</span>
        </div>
      </div>

      <!-- Col 2: Operational Info & Address -->
      <div class="footer-col-info">
        <h4 class="footer-heading">Papan & Wektu</h4>
        <div class="footer-info-group">
          <p class="footer-label">Jam Buka:</p>
          <p class="footer-val">Saben Dina (Setiap Hari)<br />08.00 – 23.00 WIB</p>
        </div>
        <div class="footer-info-group" style="margin-top: var(--space-3);">
          <p class="footer-label">Alamat:</p>
          <p class="footer-val">Jl. Pendopo Asri No. 12, Jawa Timur</p>
        </div>
      </div>

      <!-- Col 3: Quick Links & Social -->
      <div class="footer-col-links">
        <h4 class="footer-heading">Sambung Sedulur</h4>
        <ul class="footer-list">
          <li>
            <a
              href="https://maps.google.com/?q=Ndalem+Kopi"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link"
              aria-label="Buka lokasi Ndalem Kopi di Google Maps"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Google Maps</span>
            </a>
          </li>
          <li>
            <a
              href="https://instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link"
              aria-label="Kunjungi Instagram Ndalem Kopi"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>Instagram</span>
            </a>
          </li>
          <li>
            <a
              href="https://tiktok.com"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link"
              aria-label="Kunjungi TikTok Ndalem Kopi"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
              </svg>
              <span>TikTok</span>
            </a>
          </li>
          <li>
            <a
              href="/reservasi"
              class="footer-link"
              aria-label="Formulir Reservasi Meja Ndalem Kopi"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z"></path>
              </svg>
              <span>Reservasi Meja Online</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <p>© {currentYear} Ndalem Kopi. Sedaya hak katetepaken. · <a href="/admin" style="color:var(--color-amber); opacity:0.85;">Portal Pawon (Admin)</a></p>
      <p class="footer-motto">Suguhan Khas Jawa · Ngopi lan Crita</p>
    </div>
  </div>
</footer>

<style>
  .footer-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-amber);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 2px;
  }

  .footer-val {
    font-size: var(--text-sm);
    color: var(--color-text-light-muted);
    line-height: 1.5;
  }

  .footer-motto {
    font-family: var(--font-serif);
    font-style: italic;
  }
</style>
