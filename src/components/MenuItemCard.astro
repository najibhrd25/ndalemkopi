---
import type { MenuItem } from '../data/menu';
import { formatPrice } from '../data/menu';

interface Props {
  item: MenuItem;
  variant?: 'editorial' | 'card' | 'compact';
}

const { item, variant = 'editorial' } = Astro.props;
---

{variant === 'editorial' && (
  <article class="menu-item-row" data-item-id={item.id}>
    {item.image && (
      <div class="menu-item-thumb">
        <img src={item.image} alt={item.name} loading="lazy" />
      </div>
    )}
    <div class="menu-item-content">
      <div class="menu-item-header">
        <div class="menu-item-title-wrap">
          <h3 class="menu-item-name font-serif">{item.name}</h3>
          {item.signature && <span class="badge badge-signature">Signature</span>}
          {item.favorite && !item.signature && <span class="badge badge-favorite">Favorit</span>}
        </div>
        <span class="dot-leader" aria-hidden="true"></span>
        <span class="menu-item-price">{formatPrice(item.price)}</span>
      </div>
      {item.description && <p class="menu-item-desc">{item.description}</p>}
      {item.notes && <p class="menu-item-note">{item.notes}</p>}
    </div>
  </article>
)}

{variant === 'compact' && (
  <article class="compact-card" data-item-id={item.id} data-category={item.category} data-type={item.type}>
    <div class="compact-media-wrap">
      {item.image ? (
        <img src={item.image} alt={item.name} loading="lazy" class="compact-img" />
      ) : (
        <div class="compact-placeholder">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <span class="compact-placeholder-text">{item.categoryName || (item.type === 'minuman' ? 'Ombenan' : 'Panganan')}</span>
        </div>
      )}
      <div class="compact-badges">
        {item.signature && <span class="badge badge-signature">Signature</span>}
        {item.favorite && !item.signature && <span class="badge badge-favorite">Favorit</span>}
      </div>
    </div>
    
    <div class="compact-body">
      <div class="compact-header">
        <h3 class="compact-title font-serif">{item.name}</h3>
        <span class="compact-price">{formatPrice(item.price)}</span>
      </div>
      {item.description && <p class="compact-desc">{item.description}</p>}
    </div>
  </article>
)}

{variant === 'card' && (
  <article class="menu-card" data-item-id={item.id} data-category={item.category} data-type={item.type}>
    {/* Dedicated Photo Space (User requirement) */}
    <div class="menu-card-media">
      {item.image ? (
        <img src={item.image} alt={item.name} loading="lazy" class="menu-card-img" />
      ) : (
        <div class="menu-card-placeholder">
          <div class="placeholder-icon" aria-hidden="true">
            {item.type === 'minuman' ? (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
                <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
                <line x1="6" y1="1" x2="6" y2="4"></line>
                <line x1="10" y1="1" x2="10" y2="4"></line>
                <line x1="14" y1="1" x2="14" y2="4"></line>
              </svg>
            ) : (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a10 10 0 0 0-10 10c0 5.523 4.477 10 10 10s10-4.477 10-10A10 10 0 0 0 12 2z"></path>
                <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                <line x1="9" y1="9" x2="9.01" y2="9"></line>
                <line x1="15" y1="9" x2="15.01" y2="9"></line>
              </svg>
            )}
          </div>
          <span class="placeholder-label">{item.categoryName || (item.type === 'minuman' ? 'Ombenan' : 'Panganan')}</span>
        </div>
      )}
      
      {/* Badge Overlay */}
      <div class="media-badges">
        {item.signature && <span class="badge badge-signature">Signature</span>}
        {item.favorite && <span class="badge badge-favorite">Favorit</span>}
      </div>
    </div>

    <div class="menu-card-body">
      <div class="menu-card-header-info">
        <h3 class="menu-card-name font-serif">{item.name}</h3>
        <span class="menu-card-price">{formatPrice(item.price)}</span>
      </div>

      {item.description && <p class="menu-card-desc">{item.description}</p>}
    </div>
    
    {item.notes && (
      <div class="menu-card-footer">
        <span class="menu-item-note">{item.notes}</span>
      </div>
    )}
  </article>
)}

<style>
  /* Editorial Row Thumbnail */
  .menu-item-thumb {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    flex-shrink: 0;
    margin-right: 0.75rem;
    border: 1px solid var(--color-border);
  }

  .menu-item-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Compact Card (Reference: galektech.vercel.app/project - compact footprint, rounded media, 3-in-a-row) */
  .compact-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: 0 2px 6px rgba(40, 29, 23, 0.04);
  }

  .compact-card:hover {
    border-color: var(--color-terracotta);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(40, 29, 23, 0.08);
  }

  .compact-media-wrap {
    position: relative;
    width: 100%;
    height: 135px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-bg-surface);
    margin-bottom: 0.75rem;
  }

  .compact-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .compact-card:hover .compact-img {
    transform: scale(1.05);
  }

  .compact-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    background: linear-gradient(135deg, #F5EFE6, #EAE0D2);
    color: var(--color-text-subtle);
  }

  .compact-placeholder-text {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .compact-badges {
    position: absolute;
    top: 6px;
    right: 6px;
    display: flex;
    gap: 4px;
    z-index: 2;
  }

  .compact-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.35rem;
  }

  .compact-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .compact-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-wood);
    line-height: 1.25;
    margin: 0;
  }

  .compact-price {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-terracotta);
    white-space: nowrap;
  }

  .compact-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Card specific styles (Menu page / bento grid) */
  .menu-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    transition: all var(--transition-fast);
    box-shadow: 0 1px 3px rgba(40, 29, 23, 0.04);
  }

  .menu-card:hover {
    border-color: var(--color-terracotta);
    box-shadow: 0 4px 12px rgba(40, 29, 23, 0.08);
    transform: translateY(-2px);
  }

  /* Dedicated Photo Space */
  .menu-card-media {
    position: relative;
    width: 100%;
    height: 140px;
    background-color: var(--color-bg-surface);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .menu-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .menu-card:hover .menu-card-img {
    transform: scale(1.04);
  }

  .menu-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    color: var(--color-text-subtle);
    background: linear-gradient(145deg, #F9F4EC, #EDE3D4);
  }

  .placeholder-icon {
    color: var(--color-terracotta);
    opacity: 0.75;
  }

  .placeholder-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .media-badges {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    gap: 4px;
    z-index: 2;
  }

  /* Body Content */
  .menu-card-body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-2);
  }

  .menu-card-header-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .menu-card-name {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-wood);
    line-height: 1.3;
  }

  .menu-card-price {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-terracotta);
    align-self: flex-start;
  }

  .menu-card-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .menu-card-footer {
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-base);
    border-top: 1px dashed var(--color-border-subtle);
  }

  .menu-item-note {
    font-size: 0.6875rem;
    color: var(--color-amber);
    font-weight: 600;
    display: block;
    line-height: 1.4;
  }
</style>
