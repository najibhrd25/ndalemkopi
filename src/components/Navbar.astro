---
const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/\/$/, '') || '/';

const navItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Menu', href: '/menu' },
  { label: 'Tentang', href: '/tentang' }
];

function isActive(href: string) {
  const cleanHref = href.replace(/\/$/, '') || '/';
  if (cleanHref === '/') return cleanPath === '/';
  return cleanPath.startsWith(cleanHref);
}
---

<header class="header-nav" role="banner" id="site-header">
  <div class="container">
    <div class="nav-container">
      <!-- Brand Logo -->
      <a href="/" class="brand-logo" aria-label="Ndalem Kopi - Beranda">
        <span class="brand-title">Ndalem Kopi</span>
        <span class="brand-tagline">Kopi · Mangan · Crita</span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="nav-links-desktop" aria-label="Navigasi Utama">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Desktop Action CTA -->
      <div class="nav-actions-desktop">
        <a href="/menu" class="btn btn-primary" id="desktop-menu-cta">
          Delok Menu
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        class="mobile-menu-btn"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-drawer-nav"
        aria-label="Buka navigasi menu"
      >
        <span class="sr-only">Menu</span>
        <svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobile-drawer-nav" aria-label="Menu Navigasi Mobile">
    <div class="container mobile-drawer-inner">
      <nav aria-label="Navigasi Menu Mobile">
        <ul class="mobile-nav-list">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class={`mobile-nav-link ${isActive(item.href) ? 'active' : ''}`}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <span>{item.label}</span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mobile-drawer-footer">
        <a href="/menu" class="btn btn-primary btn-block">
          Delok Menu Lengkap
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <div class="mobile-contact-snippet">
          <p><strong>Jam Buka:</strong> 08.00 – 23.00 WIB</p>
          <p>Jl. Pendopo Asri No. 12, Jawa Timur</p>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .btn-block {
    width: 100%;
    margin-bottom: var(--space-4);
  }

  .mobile-drawer-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
  }

  .mobile-drawer-footer {
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
    margin-top: auto;
  }

  .mobile-contact-snippet {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }

  .mobile-contact-snippet strong {
    color: var(--color-terracotta);
  }
</style>

<script is:inline>
  (function () {
    function initMobileNav() {
      var toggleBtn = document.getElementById('mobile-menu-toggle');
      var drawer = document.getElementById('mobile-drawer-nav');
      if (!toggleBtn || !drawer) return;

      var iconOpen = toggleBtn.querySelector('.icon-open');
      var iconClose = toggleBtn.querySelector('.icon-close');

      function setMenuState(open) {
        if (open) {
          drawer.classList.add('open');
          toggleBtn.setAttribute('aria-expanded', 'true');
          if (iconOpen) iconOpen.style.display = 'none';
          if (iconClose) iconClose.style.display = 'block';
          document.documentElement.style.overflow = 'hidden';
          document.body.style.overflow = 'hidden';
        } else {
          drawer.classList.remove('open');
          toggleBtn.setAttribute('aria-expanded', 'false');
          if (iconOpen) iconOpen.style.display = 'block';
          if (iconClose) iconClose.style.display = 'none';
          document.documentElement.style.overflow = '';
          document.body.style.overflow = '';
        }
      }

      // Remove existing listener if re-running
      toggleBtn.onclick = function (e) {
        e.preventDefault();
        e.stopPropagation();
        var isOpen = drawer.classList.contains('open');
        setMenuState(!isOpen);
      };

      // Close menu when clicking links
      var navLinks = drawer.querySelectorAll('a');
      for (var i = 0; i < navLinks.length; i++) {
        navLinks[i].onclick = function () {
          setMenuState(false);
        };
      }

      // Close menu on Escape key
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && drawer.classList.contains('open')) {
          setMenuState(false);
          toggleBtn.focus();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileNav);
    } else {
      initMobileNav();
    }
  })();
</script>
